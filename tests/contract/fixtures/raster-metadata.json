{
  "call": "DDBGetRasterMetadata(<root>/ortho.tif, formula=NULL, bandFilter=NULL)",
  "description": "The contract dataset: tests/contract/inputs (a.txt, cloud.las, layer.geojson, ortho.tif, sub/img.jpg) copied to <root> with mtime 1700000000, indexed with DDBAdd",
  "normalisation": {
    "placeholders": [
      "<root>"
    ],
    "volatileKeys": []
  },
  "output": {
    "algorithms": [
      {
        "expr": "(G - R) / (G + R - B)",
        "help": "Areas of green vegetation on RGB images",
        "id": "VARI",
        "name": "Visual Atmospheric Resistance Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "expr": "(2 * G) - (R + B)",
        "help": "Emphasizes green foliage",
        "id": "EXG",
        "name": "Excess Green Index"
      },
      {
        "expr": "((G * 2) - R - B) / ((G * 2) + R + B)",
        "help": "Green leaves and stems",
        "id": "GLI",
        "name": "Green Leaf Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "expr": "0.5268 * (R^-0.1294 * G^0.3389 * B^-0.3118)",
        "help": "Approximated NDVI for RGB sensors",
        "id": "vNDVI",
        "name": "Visible NDVI"
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: RN",
        "expr": "(N - R) / (N + R)",
        "help": "Amount of green vegetation",
        "id": "NDVI",
        "name": "Normalized Difference Vegetation Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: GN",
        "expr": "(G - N) / (G + N)",
        "help": "Water content",
        "id": "NDWI",
        "name": "Normalized Difference Water Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: GN",
        "expr": "(N - G) / (N + G)",
        "help": "NDVI on green spectrum",
        "id": "GNDVI",
        "name": "Green NDVI",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: RN",
        "expr": "(1.5 * (N - R)) / (N + R + 0.5)",
        "help": "NDVI with soil correction",
        "id": "SAVI",
        "name": "Soil Adjusted Vegetation Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: RBN",
        "expr": "2.5 * (N - R) / (N + 6*R - 7.5*B + 1)",
        "help": "Better where NDVI saturates",
        "id": "EVI",
        "name": "Enhanced Vegetation Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: NRe",
        "expr": "(N - Re) / (N + Re)",
        "help": "Green vegetation in mature crops",
        "id": "NDRE",
        "name": "Normalized Difference Red Edge",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "expr": "(G - B) / (G + B)",
        "help": "Yellowness detection",
        "id": "NDYI",
        "name": "Normalized Difference Yellowness Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "expr": "(G - R) / (G + R)",
        "help": "Photochemical reflectance",
        "id": "MPRI",
        "name": "Modified Photochemical Reflectance Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: RN",
        "expr": "(N - R) / (N + R + 0.16)",
        "help": "Optimized for sparse vegetation",
        "id": "OSAVI",
        "name": "Optimized Soil Adjusted Vegetation Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: GN",
        "expr": "N / G",
        "help": "Green ratio",
        "id": "GRVI",
        "name": "Green Ratio Vegetation Index"
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: GBN",
        "expr": "((N + G) - (2*B)) / ((N + G) + (2*B))",
        "help": "Enhanced NDVI",
        "id": "ENDVI",
        "name": "Enhanced NDVI"
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: RBN",
        "expr": "(N - (2*R) + B) / (N + (2*R) + B)",
        "help": "Corrects atmospheric effects",
        "id": "ARVI",
        "name": "Atmospherically Resistant Vegetation Index",
        "range": [
          -1.0,
          1.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: T",
        "expr": "pixel value (passthrough)",
        "help": "Temperature in degrees Celsius",
        "id": "CELSIUS",
        "name": "Celsius Temperature",
        "range": [
          -40.0,
          150.0
        ]
      },
      {
        "disabled": true,
        "disabledReason": "Requires bands: T",
        "expr": "pixel + 273.15",
        "help": "Temperature in Kelvin",
        "id": "KELVIN",
        "name": "Kelvin Temperature",
        "range": [
          233.15,
          423.15
        ]
      }
    ],
    "autoBands": {
      "filter": "RGB",
      "match": true
    },
