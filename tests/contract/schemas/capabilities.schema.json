{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "libddb capabilities",
  "description": "DDBGetCapabilities (XI-01): ABI version, library version, error codes, cancellable exports and the exported symbols (src/include/ddb.symbols)",
  "type": "object",
  "required": [
    "abi",
    "version",
    "errorCodes",
    "cancellable",
    "symbols"
  ],
  "additionalProperties": false,
  "properties": {
    "abi": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 1
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "errorCodes": {
      "description": "Every DDBErr code under its name without the DDBERR_ prefix; codes are only added",
      "type": "object",
      "required": [
        "NONE",
        "EXCEPTION",
        "BUILDDEPMISSING",
        "BUILDINPROGRESS",
        "CANCELED",
        "BUSY",
        "NOTFOUND"
      ],
      "properties": {
        "NONE": {
          "const": 0
        },
        "EXCEPTION": {
          "const": 1
        },
        "BUILDDEPMISSING": {
          "const": 2
        },
        "BUILDINPROGRESS": {
          "const": 3
        },
        "CANCELED": {
          "const": 4
        },
        "BUSY": {
          "const": 5
        },
        "NOTFOUND": {
          "const": 6
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "cancellable": {
      "description": "Exports that return DDBERR_CANCELED when their DDBProgressCallback asks to stop",
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "symbols": {
      "description": "Every exported DDB* function, sorted in byte order",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    }
  },
  "$defs": {
    "symbol": {
      "type": "string",
      "pattern": "^DDB[A-Za-z0-9_]+$"
    }
  }
}
