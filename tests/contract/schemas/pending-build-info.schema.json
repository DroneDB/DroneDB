{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "libddb pending builds",
  "description": "DDBGetPendingBuildInfo",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "hash",
      "path",
      "missingDependencies",
      "lastAttempt"
    ],
    "additionalProperties": false,
    "properties": {
      "hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "path": {
        "type": "string"
      },
      "missingDependencies": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Dataset-relative names"
      },
      "lastAttempt": {
        "type": "integer",
        "minimum": 0,
        "description": "Unix epoch seconds (integer)"
      }
    }
  }
}
