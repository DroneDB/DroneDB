{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "libddb raster info",
  "description": "DDBGetRasterInfo",
  "type": "object",
  "required": [
    "width",
    "height",
    "bandCount",
    "dataType",
    "crs",
    "bands",
    "availablePresets",
    "defaultPreset",
    "detectedSensor",
    "indexLayer",
    "algorithms",
    "colormaps",
    "autoBands"
  ],
  "additionalProperties": false,
  "properties": {
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "bandCount": {
      "type": "integer"
    },
    "dataType": {
      "type": "string"
    },
    "crs": {
      "type": "string"
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "index",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string"
          },
          "colorInterpretation": {
            "type": "string"
          },
          "wavelength": {
            "type": "number"
          }
        }
      }
    },
    "availablePresets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "isDefault"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "bandMapping": {},
          "isDefault": {
            "type": "boolean"
          },
          "type": {
            "const": "index"
          },
          "formula": {
            "type": "string"
          },
          "colormap": {
            "type": "string"
          }
        }
      }
    },
    "defaultPreset": {
      "type": [
        "string",
        "null"
      ]
    },
    "detectedSensor": {
      "type": [
        "string",
        "null"
      ]
    },
    "detectedSensorName": {
      "description": "the name of the sensor profile next to its id; absent when no profile matched (new in 2.4)",
      "type": "string"
    },
    "indexLayer": {
      "type": "array",
      "items": {
        "enum": [
          "NDVI",
          "NDRE",
          "NDWI",
          "SAVI",
          "EVI"
        ]
      },
      "description": "The spectral indices the WMS vegetation-index layer renders from the raster, in the layer's order"
    },
    "algorithms": {
      "description": "as in DDBGetRasterMetadata without a band filter (new in 2.11)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "expr",
          "help",
          "requiredBands",
          "category"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "expr": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "requiredBands": {
            "description": "the names of the bands the formula reads (new in 2.4)",
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "category": {
            "description": "the kind of raster the formula is for (new in 2.4)",
            "enum": [
              "rgb",
              "multispectral",
              "thermal"
            ]
          },
          "range": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "disabled": {
            "type": "boolean"
          },
          "disabledReason": {
            "type": "string"
          }
        }
      }
    },
    "colormaps": {
      "description": "as in DDBGetRasterMetadata without a band filter (new in 2.11)",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "colors"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "colors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      }
    },
    "autoBands": {
      "description": "as in DDBGetRasterMetadata without a band filter (new in 2.11)",
      "type": "object",
      "required": [
        "filter",
        "match"
      ],
      "additionalProperties": false,
      "properties": {
        "filter": {
          "type": "string"
        },
        "match": {
          "type": "boolean"
        }
      }
    }
  }
}
