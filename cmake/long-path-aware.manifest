<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Application manifest of the Windows programs DroneDB builds (cmake/LongPathAware.cmake).
     longPathAware lets the Win32 file functions, and the C and C++ library functions and the
     third-party libraries built on them (PDAL, GDAL, Untwine, Exiv2), take a path of 260
     characters or more. It has an effect only where Windows allows long paths:
     LongPathsEnabled=1 in HKLM\SYSTEM\CurrentControlSet\Control\FileSystem. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
